# droid-observatory environment. Copy to .env (gitignored) or export in your shell.
# Secrets belong in the OS keychain where the app runs; the environment is the fallback
# and what CI uses (ai/RULES.md rule 4).

# --- GitHub (gate lane: PR, checks, rulesets, merge) ---
# Fine-grained token: contents:read, pull_requests:write, checks:read, metadata:read on the
# target repo. Keychain entry: droid-observatory/github-token
GITHUB_TOKEN=

# --- Factory (hosting missions) ---
# Not needed when `droid` is already logged in on this machine; the app spawns the CLI.
# FACTORY_API_KEY=

# --- Grafana Cloud OTLP (docs/decisions/D-004, contract D-010) ---
# CI only (B-002). The app does NOT read these: the endpoint is in config and the
# Authorization header comes from the macOS keychain item droid-observatory/otlp-headers
# (account = current user). Never put the header value in a file.
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-eu-west-2.grafana.net/otlp
# "Authorization=Basic <base64(instanceId:token)>"
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_SERVICE_NAME=droid-observatory

# --- Local overrides ---
# Path to a config file other than ~/.droid-observatory/config.toml
# OBSERVATORY_CONFIG=
# Log level for the app's own tracing (error|warn|info|debug|trace). Default info.
# OBSERVATORY_LOG=info
